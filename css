body {
  background: #f6f6f6 url('https://i.pinimg.com/originals/66/fb/f3/66fbf3a3dfd4c7352ec9f72e74a7e07e.gif') no-repeat center fixed;
  background-size: cover;
  font-family: 'Georgia', serif;
  color: #444;
}

main {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(6px);
  border-radius: 2em;
  padding: 2em;
  box-shadow: 0 0 30px rgba(100, 100, 100, 0.1);
}

h1, h2, h3 {
  font-family: 'Georgia', serif;
  color: #888;
  letter-spacing: 1px;
}

a {
  color: #aaa;
  text-decoration: none;
  transition: color 0.3s;
}
a:hover {
  color: #555;
}

.profile-pic img {
  filter: grayscale(100%) brightness(120%);
  border-radius: 1.5em;
  opacity: 0.8;
}

nav, footer, .contact, .table-section,
.blurbs, .friends, .table,
.details-table td {
  background: transparent;
  border: none;
  color: #888;
}

::-webkit-scrollbar {
  width: 8px;
}
::-webkit-scrollbar-thumb {
  background: #ccc;
  border-radius: 8px;
}

*:focus {
  outline: none !important;
  box-shadow: none !important;
}
